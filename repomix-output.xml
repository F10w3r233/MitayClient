package com.flower.mitayclient.GUI.HUD;

import com.flower.Mitayclient;
import com.flower.mitayclient.util.Resource;
import com.google.common.collect.Ordering;
import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.GuiGraphicsExtractor;
import net.minecraft.client.renderer.RenderPipelines;
import net.minecraft.client.renderer.texture.MissingTextureAtlasSprite;
import net.minecraft.core.Holder;
import net.minecraft.network.chat.Component;
import net.minecraft.network.chat.Style;
import net.minecraft.resources.Identifier;
import net.minecraft.resources.ResourceKey;
import net.minecraft.util.ARGB;
import net.minecraft.util.Mth;
import net.minecraft.world.effect.MobEffect;
import net.minecraft.world.effect.MobEffectInstance;

import java.util.*;
import java.util.stream.Collectors;

public class StatusEffectHudRenderer {
    // 动画偏移量
    private static int x1 = 0;
    private static int x2 = 0;
    private static int x3 = 0;
    private static int x4 = 0;
    private static int x5 = 0;

    // 缓存：上次的效果集合和排序后的列表
    private static Set<Holder<MobEffect>> lastEffectHolders = null;
    private static List<MobEffectInstance> sortedEffects = new ArrayList<>();

    public static void render(GuiGraphicsExtractor context) {
        if (!Mitayclient.getConfig().isEffectShown()) {
            return;
        }

        Minecraft client = Minecraft.getInstance();
        if (client.player == null) return;

        Collection<MobEffectInstance> collection = client.player.getActiveEffects();

        if (!collection.isEmpty()
                && (client.screen == null || !Minecraft.getInstance().screen.showsActiveEffects())
                && !Minecraft.getInstance().options.hideGui) {

            // 检测效果组成是否发生变化（添加/移除效果）
            Set<Holder<MobEffect>> currentHolders = collection.stream()
                    .map(MobEffectInstance::getEffect)
                    .collect(Collectors.toSet());

            if (lastEffectHolders == null || !currentHolders.equals(lastEffectHolders)) {
                lastEffectHolders = currentHolders;
                sortedEffects = Ordering.natural().reverse().sortedCopy(collection);
                // 重置动画
                x1 = -83;
                x2 = -79;
                x3 = -76;
                x4 = -50;
                x5 = -90;
            }

            // 每帧只更新一次动画变量
            if (x1 < 16) x1++;
            if (x2 < 21) x2++;
            if (x3 < 24) x3++;
            if (x4 < 50) x4++;
            if (x5 < 95) x5++;

            int gap = 40;
            int i = 0;

            for (MobEffectInstance effectInstance : sortedEffects) {
                i++;
                Holder<MobEffect> holder = effectInstance.getEffect();
                MobEffect effect = holder.value();

                // 闪烁效果
                float f = 1.0F;
                if (effectInstance.endsWithin(200)) {
                    int m = effectInstance.getDuration();
                    int n = 10 - m / 20;
                    f = Mth.clamp((float) m / 10.0F / 5.0F * 0.5F, 0.0F, 0.5F)
                            + Mth.cos((float) m * 3.1415927F / 5.0F)
                            * Mth.clamp((float) n / 10.0F * 0.25F, 0.0F, 0.25F);
                    f = Mth.clamp(f, 0.0F, 1.0F);
                }
                int alpha = ARGB.white(f);

                // 时间格式化（修复负值）
                int totalDuration = Math.max(0, effectInstance.getDuration() / 20);
                int min = totalDuration / 60;
                int second = totalDuration % 60;
                String time = String.format("%02d:%02d", min, second);

                // 效果等级字符串
                String effectLevel = switch (effectInstance.getAmplifier()) {
                    case 1 -> " II";
                    case 2 -> " III";
                    case 3 -> " IV";
                    case 4 -> " V";
                    case 5 -> " VI";
                    default -> "";
                };

                // 复用 Component，避免重复调用 getDisplayName()
                Component effectName = Component.literal(
                        effect.getDisplayName().getString() + effectLevel
                ).setStyle(Style.EMPTY.withBold(true));

                // 计算条形长度（直接使用原版字体宽度）
                int nameWidth = client.font.width(effectName);
                int timeWidth = client.font.width(time);
                int length = Math.max(nameWidth, timeWidth) + 10;

                int yOffset = gap * i;

                // 背景栏
                Identifier bar;
                if (Mitayclient.getConfig().isDarkShown()) {
                    bar = effectInstance.isAmbient()
                            ? Resource.EFFECT_BAR_AMBIENT_DARK
                            : Resource.EFFECT_BAR_DARK;
                } else {
                    bar = effectInstance.isAmbient()
                            ? Resource.EFFECT_BAR_AMBIENT
                            : Resource.EFFECT_BAR;
                }
                context.blit(RenderPipelines.GUI_TEXTURED, bar,
                        x1, yOffset - 8, 0, 0,
                        35 + length, 34, 35 + length, 34, alpha);

                // 负面效果标记
                if (!effect.isBeneficial()) {
                    context.blit(RenderPipelines.GUI_TEXTURED, Resource.EFFECT_BAR_BAD,
                            x2, yOffset - 3, 0, 0,
                            24, 24, 24, 24, alpha);
                }

                // 效果图标
                Identifier sprite = getEffectTexture(holder);
                context.blitSprite(RenderPipelines.GUI_TEXTURED, sprite,
                        x3, yOffset, 18, 18, alpha);

                // 效果名称（加粗）
                context.text(client.font, effectName,
                        x4, yOffset - 1,
                        ARGB.color(alpha, effect.getColor()));

                // 倒计时（10秒内红色警告）
                int timeColor = (min == 0 && second <= 10) ? 12400439 : 111111;
                context.text(client.font, time,
                        x4, yOffset + 11,
                        ARGB.color(alpha, timeColor));
            }
        }
    }

    public static Identifier getEffectTexture(Holder<MobEffect> effect) {
        return effect.unwrapKey()
                .map(ResourceKey::identifier)
                .map(id -> id.withPrefix("mob_effect/"))
                .orElseGet(MissingTextureAtlasSprite::getLocation);
    }
}
