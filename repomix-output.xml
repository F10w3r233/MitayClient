                }
            }
            for (GuiEventListener child : new ArrayList<>(scrollArea.children))
            {
                if (child instanceof PlaceListButton || child instanceof SwitchButton || child instanceof MultiColumnTextFieldWidget)
                {
                    removeWidget(child);
                }
            }
            scrollArea.children.clear();
